+// ── SAF adaptive field helpers ───────────────────────────────────────────────
+// Estos helpers vivían por error DENTRO de OmegaSharedState (sentencias a
+// nivel de clase) y rompían la compilación del target NDK. Se conservan
+// íntegros aquí, ya como funciones inline utilizables desde el hot-path.
+
+inline float applySAFGain(float sample)
+{
+    return sample * static_cast<float>(
+        g_saf_state.gain.load(std::memory_order_relaxed));
+}
+
+
+// SAF FULL MATHEMATICS
+// Φ_SAF = ΠS(p + factor * G^-1 * Δ)
+inline float safTick(float safTarget = 1.0f)
+{
+    float safCurrent =
+        static_cast<float>(g_saf_state.gain.load(std::memory_order_relaxed));
+
+
+    float safGain =
+        SAFUpdate(
+            safCurrent,
+            safTarget
+        );
+
+
+    g_saf_state.gain.store(safGain, std::memory_order_relaxed);
+
+    return safGain;
+}
