From 22c7f41660081fd901cf81eca2936f5bb80e1114 Mon Sep 17 00:00:00 2001
From: "Gore TNS (audit session)" <gore-tns@ivanna-omega.local>
Date: Wed, 22 Jul 2026 22:46:34 +0000
Subject: [PATCH 5/5] fix(ui): AdaptiveControlsCard refleja que Mode/Intensity
 ya tienen backend real
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Reconstruido a partir de un cambio que Luis ya habia hecho en su working
tree (mezclado sin querer con una regresion en otros 4 archivos, que se
descarto por separado). Este cambio SI es trabajo nuevo legitimo —
verificado antes de comitear:

grep confirma implementacion JNI real (no stub) de
Java_com_ivanna_omega_core_IvannaNativeLib_nativeSetAdaptiveControls en
ivanna_omega_jni.cpp, consistente con los commits recientes que cerraron
ese cableado (ce929eb, 6a534c7, b2ab053, 43fe1f7).

Se actualiza el disclaimer de Mode/Intensity de "sin backend real (TODO)"
a "Real — nativeSetAdaptiveControls(...)", con el mismo color/estilo que
ya usaba el disclaimer real de Voice Protection. PendingBackendNote() se
renombra a RealBackendNote(text) parametrizable.
---
 .../com/ivanna/omega/ui/AdaptiveEngineCard.kt | 27 +++++++++----------
 1 file changed, 13 insertions(+), 14 deletions(-)

diff --git a/app/src/main/java/com/ivanna/omega/ui/AdaptiveEngineCard.kt b/app/src/main/java/com/ivanna/omega/ui/AdaptiveEngineCard.kt
index 6d85f52..3b484ad 100644
--- a/app/src/main/java/com/ivanna/omega/ui/AdaptiveEngineCard.kt
+++ b/app/src/main/java/com/ivanna/omega/ui/AdaptiveEngineCard.kt
@@ -35,19 +35,18 @@ import com.ivanna.omega.ui.theme.*
 //  un espejo 1:1 del FloatArray de 10 posiciones que ese endpoint devuelve.
 //
 //  Auditoría de cableado (Fase 5 del prompt) de cada control:
-//    - Adaptive Mode (OFF/NATURAL/STUDIO/EXTREME): SIN backend. El motor no
-//      tiene concepto de "modo" — es un engine de decisión continua, no
-//      basado en presets. UI preparada + TODO explícito, no se inventa
-//      comportamiento.
-//    - Intensity 0-100%: SIN backend. No existe ningún escalar de
-//      "intensidad global" en AdaptiveDecisionEngine ni en su bus de
-//      estado. UI preparada + TODO explícito.
-//    - Spatial Control 0-150%: SÍ tiene backend real — ParameterStore.
+//    - Adaptive Mode (OFF/NATURAL/STUDIO/EXTREME): backend REAL vía
+//      MainActivity.applyAdaptiveUiControls() ->
+//      IvannaNativeLib.nativeSetAdaptiveControls(mode, intensity) -> JNI.
+//      El C++ modula la fuerza del AdaptiveDecisionEngine según el modo.
+//    - Intensity 0-100%: backend REAL por la misma ruta JNI anterior.
+//      La intensidad escala la aplicación del motor adaptativo en tiempo real.
+//    - Spatial Control 0-150%: backend REAL — ParameterStore.
 //      setSpatialWidth()/getSpatialWidth(), la MISMA ruta que ya usaba el
 //      slider manual de ancho estéreo en IvannaControlPanel. Distinto
 //      concepto de "Spatial Intelligence" (telemetría, decisión calculada
 //      por el motor) — acá el usuario fija la base que el motor modula.
-//    - Voice Protection ON/OFF: SÍ tiene backend real —
+//    - Voice Protection ON/OFF: backend REAL —
 //      IvannaBridgePlayer.setVoiceProtectionEnabled(), que delega a
 //      VoiceProtectionController.enabled (confirmado que SÍ gatea feed()
 //      de verdad, no es un flag muerto).
@@ -218,7 +217,7 @@ fun AdaptiveControlsCard(
                 )
             }
         }
-        PendingBackendNote()
+        RealBackendNote("Real — nativeSetAdaptiveControls(mode, intensity)")
 
         AuroraSlider(
             label = "Intensity",
@@ -227,7 +226,7 @@ fun AdaptiveControlsCard(
             unit = "%",
             onValueChange = onIntensityChange
         )
-        PendingBackendNote()
+        RealBackendNote("Real — AdaptiveDecisionEngine modulado por JNI")
 
         // REAL: mapea a ParameterStore.setSpatialWidth(), la misma ruta que
         // ya consume el slider manual de ancho estéreo — no un motor
@@ -258,11 +257,11 @@ fun AdaptiveControlsCard(
 }
 
 @Composable
-private fun PendingBackendNote() {
+private fun RealBackendNote(text: String) {
     Text(
-        "⚠ UI preparada — sin backend real todavía (TODO)",
+        text,
         style = MaterialTheme.typography.labelSmall,
-        color = AmberSignal.copy(alpha = 0.85f)
+        color = PhosphorGreen.copy(alpha = 0.85f)
     )
 }
 
