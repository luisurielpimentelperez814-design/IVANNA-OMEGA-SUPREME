diff --git a/magisk_module/sepolicy.rule b/magisk_module/sepolicy.rule
index 4c5e2d7..a33c6d9 100644
--- a/magisk_module/sepolicy.rule
+++ b/magisk_module/sepolicy.rule
@@ -1,20 +1,43 @@
-# IVANNA OMEGA SUPREME — SELinux policy rules
-# Permite que la app (untrusted_app) se conecte al socket abstracto Unix
-# del daemon (que corre como root: u:r:su:s0 o u:r:magisk:s0).
+# IVANNA OMEGA SUPREME — SELinux policy rules (magiskpolicy syntax)
 #
-# Sin estas reglas Android 8+ bloquea connect() silenciosamente:
-# avc: denied { connectto } scontext=u:r:untrusted_app:s0 tcontext=u:r:su:s0
+# FIX CRITICO (2026-08-10):
+#   Este archivo estaba escrito en sintaxis .te de SELinux
+#   ("allow untrusted_app su:unix_stream_socket connectto;" — con dos puntos,
+#   llaves y punto y coma). magiskpolicy NO acepta esa sintaxis: espera
+#   sentencias en formato
+#       allow <source> <target> <class> <permisos>
+#   sin dos puntos entre target y clase y sin punto y coma final.
+#   Resultado: ni el cargador automatico de Magisk (que lee sepolicy.rule en
+#   post-fs-data) ni `magiskpolicy --live --apply` aplicaban NADA — fallaban al
+#   parsear la primera linea. Por eso el daemon publicaba @omega_daemon_socket
+#   correctamente (visible en /proc/net/unix, daemon_active=1) pero la app
+#   nunca lograba conectarse: el kernel negaba connectto en silencio.
 #
-# Aplicado en boot por Magisk si SKIPUNZIP=0 y el módulo sigue la estructura
-# estándar, o manualmente desde service.sh con magiskpolicy --live.
+#   Verificacion en el dispositivo:
+#       su -c 'dmesg | grep -i "avc.*omega\|avc.*untrusted_app.*connectto"'
+#
+# ── Conexion de la app al socket abstracto del daemon ────────────────────────
+# El daemon lo lanza service.sh, por lo que su contexto es u:r:magisk:s0 en
+# Magisk >= 24 y u:r:su:s0 en versiones antiguas / KernelSU. Se cubren ambos.
+allow untrusted_app magisk unix_stream_socket connectto
+allow untrusted_app su unix_stream_socket connectto
+allow untrusted_app init unix_stream_socket connectto
 
-# untrusted_app → su socket (daemon lanzado por Magisk root shell)
-allow untrusted_app su:unix_stream_socket connectto;
-allow untrusted_app magisk:unix_stream_socket connectto;
+# appdomain es un atributo: cubre untrusted_app_25/27/29/30/32/... sin tener
+# que enumerar cada nivel de targetSdk, que es exactamente lo que hacia fallar
+# la conexion en Android 12+ (el dominio real es untrusted_app_30, no
+# untrusted_app).
+allow appdomain magisk unix_stream_socket connectto
+allow appdomain su unix_stream_socket connectto
 
-# La app necesita también crear su extremo del socket
-allow untrusted_app untrusted_app:unix_stream_socket { create connect read write };
+# ── Handoff del fd de memoria compartida por SCM_RIGHTS ─────────────────────
+# El daemon entrega el fd de /data/adb/ivanna_omega/omega_shm (etiqueta
+# adb_data_file) por SCM_RIGHTS. La app no abre el path — solo usa el fd
+# recibido — pero necesita read/write/map sobre esa etiqueta o el mmap()
+# fallara con EACCES aunque el fd llegue bien.
+allow untrusted_app adb_data_file file { read write map getattr }
+allow appdomain adb_data_file file { read write map getattr }
 
-# isolated_app (WebView workers, etc.) también puede necesitar conectarse
-allow isolated_app su:unix_stream_socket connectto;
-allow isolated_app magisk:unix_stream_socket connectto;
+# ── isolated_app (workers de WebView / servicios aislados) ──────────────────
+allow isolated_app magisk unix_stream_socket connectto
+allow isolated_app su unix_stream_socket connectto
diff --git a/magisk_module/service.sh b/magisk_module/service.sh
index 4c8992d..fdd9fe5 100755
--- a/magisk_module/service.sh
+++ b/magisk_module/service.sh
@@ -21,8 +21,29 @@ echo "[$(date)] service.sh v6.3 iniciado" >> "$LOGFILE"
 SEPOLICY_RULE="$MODDIR/sepolicy.rule"
 if [ -f "$SEPOLICY_RULE" ]; then
     if command -v magiskpolicy >/dev/null 2>&1; then
-        magiskpolicy --live --apply "$SEPOLICY_RULE" >> "$LOGFILE" 2>&1
-        echo "[$(date)] SELinux rules aplicadas desde $SEPOLICY_RULE" >> "$LOGFILE"
+        # FIX: `--apply <file>` aborta al primer error de parseo y devuelve
+        # distinto de 0 sin decir QUE linea fallo. Se aplica primero el archivo
+        # completo y, si falla, se cae a aplicacion linea por linea para que una
+        # regla invalida (o un dominio inexistente en esta version de Android)
+        # no tumbe TODAS las demas — que es lo que dejaba a la app sin
+        # `connectto` y con el socket del daemon inalcanzable.
+        if magiskpolicy --live --apply "$SEPOLICY_RULE" >> "$LOGFILE" 2>&1; then
+            echo "[$(date)] SELinux: sepolicy.rule aplicado completo" >> "$LOGFILE"
+        else
+            echo "[$(date)] WARN: --apply fallo; aplicando regla por regla" >> "$LOGFILE"
+            SE_OK=0; SE_FAIL=0
+            while IFS= read -r RULE; do
+                case "$RULE" in ''|'#'*) continue ;; esac
+                if magiskpolicy --live "$RULE" >> "$LOGFILE" 2>&1; then
+                    SE_OK=$((SE_OK + 1))
+                else
+                    SE_FAIL=$((SE_FAIL + 1))
+                    echo "[$(date)] SELinux regla RECHAZADA: $RULE" >> "$LOGFILE"
+                fi
+            done < "$SEPOLICY_RULE"
+            echo "[$(date)] SELinux: $SE_OK reglas aplicadas, $SE_FAIL rechazadas" >> "$LOGFILE"
+        fi
+        echo "[$(date)] SELinux modo actual: $(getenforce 2>/dev/null || echo desconocido)" >> "$LOGFILE"
     else
         echo "[$(date)] WARN: magiskpolicy no encontrado — SELinux rules NO aplicadas" >> "$LOGFILE"
     fi
@@ -30,6 +51,7 @@ else
     echo "[$(date)] WARN: sepolicy.rule no encontrado — conexiones desde la app pueden fallar" >> "$LOGFILE"
 fi
 
