diff --git a/app/src/main/cpp/daemon/ivanna_daemon.cpp b/app/src/main/cpp/daemon/ivanna_daemon.cpp
index dceb509..3481367 100644
--- a/app/src/main/cpp/daemon/ivanna_daemon.cpp
+++ b/app/src/main/cpp/daemon/ivanna_daemon.cpp
@@ -27,6 +27,8 @@
 #include <sys/un.h>
 #include <android/log.h>
 
+#include "../include/omega_shared.h"
+
 #define LOG_TAG "IVANNA_OMEGA_DAEMON"
 
 // Explicit path requirement: Must use /data/adb/ivanna_omega/omega_shm
@@ -41,6 +43,22 @@ static int g_server_fd = -1;
 static std::string g_socket_path = DEFAULT_SOCKET_PATH;
 static std::string g_log_path = DEFAULT_LOG_PATH;
 
+// FIX (crash real, verificado): omega_shm se reservaba en 65536 bytes
+// (64KB) pero OmegaSharedState (el struct canonico que ya usa la Ruta A
+// via JNI, ver include/omega_shared.h) mide 131272 bytes (128.2KB) -- casi
+// el doble, solo por input_buffer/output_buffer (128KB entre los dos).
+// Cualquier placement-new de OmegaSharedState sobre el mmap viejo escribe
+// mas alla de la region mapeada -> SIGBUS/SIGSEGV garantizado en cuanto
+// alguien cierre el puente memfd (ver omega_daemon_bridge_stub.cpp).
+// g_shared_state es el unico puntero valido al struct ya construido;
+// otras TUs del daemon (ej. CommandServer) deben pedirlo via
+// ivanna_daemon_get_shared_state(), nunca mmapear/castear por su cuenta.
+static OmegaSharedState* g_shared_state = nullptr;
+
+OmegaSharedState* ivanna_daemon_get_shared_state() {
+    return g_shared_state;
+}
+
 void log_message(const std::string& msg) {
     // 1. Android Logcat output via liblog.so
     __android_log_print(ANDROID_LOG_INFO, LOG_TAG, "%s", msg.c_str());
@@ -91,7 +109,11 @@ int setup_shared_memory() {
         return -1;
     }
 
-    size_t shm_size = 65536; // 64KB real-time ring buffer
+    // FIX (crash real, ver comentario junto a g_shared_state arriba): el
+    // tamano DEBE ser sizeof(OmegaSharedState), no un numero redondo fijo.
+    // Un valor hardcodeado que se quede corto vuelve a producir el mismo
+    // overflow si el struct crece en el futuro (ya paso: 64KB vs 128.2KB).
+    size_t shm_size = sizeof(OmegaSharedState);
     if (ftruncate(fd, shm_size) != 0) {
         log_message("Error: ftruncate failed on omega_shm: " + std::string(strerror(errno)));
         close(fd);
@@ -105,6 +127,14 @@ int setup_shared_memory() {
         return -1;
     }
 
+    // Construye el struct real in-place. omega_shm es un archivo respaldado
+    // en disco que puede traer basura (o un OmegaSharedState de una version
+    // vieja mas chica) de una corrida anterior -- placement-new lo deja en
+    // un estado conocido y valido en cada arranque del daemon.
+    g_shared_state = new (ptr) OmegaSharedState();
+    log_message("OmegaSharedState construido en omega_shm (" +
+                std::to_string(shm_size) + " bytes).");
+
     log_message("Shared Memory successfully mapped at " + std::string(OMEGA_SHM_PATH) + " (Size: " + std::to_string(shm_size) + " bytes)");
     close(fd);
     return 0;
