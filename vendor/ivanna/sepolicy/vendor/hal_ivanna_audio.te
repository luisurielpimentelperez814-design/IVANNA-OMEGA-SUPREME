

type hal_ivanna_audio, domain;

type hal_ivanna_audio_exec, exec_type, vendor_file_type, file_type;



init_daemon_domain(
    hal_ivanna_audio
);



hal_server_domain(
    hal_ivanna_audio,
    hal_audio
);



allow hal_ivanna_audio
    audio_device:chr_file
    rw_file_perms;



allow hal_ivanna_audio
    vendor_file:file
    { read open execute };



allow hal_ivanna_audio
    ashmem_device:chr_file
    rw_file_perms;



allow hal_ivanna_audio
    ion_device:chr_file
    rw_file_perms;



binder_use(
    hal_ivanna_audio
);



binder_call(
    hal_ivanna_audio,
    audioserver
);



