
<?xml version="1.0" encoding="UTF-8"?>

<audioPolicyConfiguration version="7.0">

    <globalConfiguration
        speaker_drc_enabled="true"/>


    <modules>


        <module
            name="ivanna"
            halVersion="7.1">


            <attachedDevices>

                <item>Speaker</item>
                <item>BuiltInMic</item>

            </attachedDevices>



            <defaultOutputDevice>
                Speaker
            </defaultOutputDevice>



            <mixPorts>


                <mixPort
                    name="ivanna output"
                    role="source"
                    flags="AUDIO_OUTPUT_FLAG_PRIMARY">


                    <profile
                        format="AUDIO_FORMAT_PCM_16_BIT"
                        samplingRates="48000"
                        channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>


                </mixPort>


            </mixPorts>



            <devicePorts>


                <devicePort
                    tagName="Speaker"
                    type="AUDIO_DEVICE_OUT_SPEAKER"
                    role="sink"/>



                <devicePort
                    tagName="Headphones"
                    type="AUDIO_DEVICE_OUT_WIRED_HEADPHONE"
                    role="sink"/>


            </devicePorts>



            <routes>


                <route
                    type="mix"
                    sink="Speaker"
                    sources="ivanna output"/>


                <route
                    type="mix"
                    sink="Headphones"
                    sources="ivanna output"/>


            </routes>


        </module>


    </modules>


</audioPolicyConfiguration>

