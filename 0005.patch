From cb6e3524ccb03f943b8976aaf88ccf7afd42b674 Mon Sep 17 00:00:00 2001
From: Gore TNS <gore-tns@local>
Date: Tue, 28 Jul 2026 23:31:17 +0000
Subject: [PATCH] feat(ui): sliders HRTF wet + 4 reflexiones tempranas en card
 NHO/ESPACIAL
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

PUNTO 4/4 de gaps UI-motor — cierra la lista original.

nativeSetSpatialWet y nativeSetReflectionGain ya existían en
IvannaNativeLib pero sin ningún slider en la UI que los llamara con
valores continuos.

- IvannaControlPanel.kt: 5 nuevos parámetros initial* + 2 callbacks
  (onHrtfWetChange, onReflectionGainChange con índice 0-3) + 5 AuroraSlider
  nuevos en la card 'NHO / ESPACIAL' existente (HRTF WET + 4x REFLEXIÓN
  TEMPRANA), mismo patrón remember/mutableFloatStateOf que los 3 sliders
  ya presentes en esa card. Layout no se rompe (Column con scroll).
- MainActivity.kt: wiring de ambos callbacks a
  IvannaNativeLib.nativeSetSpatialWet/nativeSetReflectionGain, con guard
  isLoaded, mismo patrón que el resto de los callbacks del panel.

AVISO documentado en el propio código: nativeSetSpatialWet ya lo pisaba
PiLstmBridge.setCochlearEnabled() como interruptor binario forzado
(toggle 'Cochlear' en la card NPE -> 0f/1f). Es comportamiento
preexistente; el slider nuevo escribe al mismo parámetro nativo porque
así ya estaba diseñado el destino. No se tocó esa lógica para no alterar
el comportamiento del toggle existente — deliberado, no un descuido.
---
 .../java/com/ivanna/omega/MainActivity.kt     | 10 +++++
 .../com/ivanna/omega/ui/IvannaControlPanel.kt | 38 +++++++++++++++++++
 2 files changed, 48 insertions(+)

diff --git a/app/src/main/java/com/ivanna/omega/MainActivity.kt b/app/src/main/java/com/ivanna/omega/MainActivity.kt
index 4ef171c..c0854c3 100644
--- a/app/src/main/java/com/ivanna/omega/MainActivity.kt
+++ b/app/src/main/java/com/ivanna/omega/MainActivity.kt
@@ -783,6 +783,16 @@ fun DashboardScreen(
                     IvannaNativeLib.nativeSetSpatialWidthDirect(it)
                 IvannaSpatialEngine.setWidth(it)
             },
+            // FIX (PUNTO 4): nativeSetSpatialWet y nativeSetReflectionGain
+            // ya existían en IvannaNativeLib, sin nada en la UI que los
+            // llamara con valores continuos (nativeSetSpatialWet solo se
+            // llamaba como 0f/1f binario desde PiLstmBridge.setCochlearEnabled).
+            onHrtfWetChange = {
+                if (IvannaNativeLib.isLoaded) IvannaNativeLib.nativeSetSpatialWet(it)
+            },
+            onReflectionGainChange = { i, g ->
+                if (IvannaNativeLib.isLoaded) IvannaNativeLib.nativeSetReflectionGain(i, g)
+            },
             // FIX: la ruta "visualizer" solo lanzaba la MediaProjection y
             // dejaba una pantalla vacia. Ahora reusa el mismo callback del
             // banner: pide captura sin sacar al usuario del dashboard.
diff --git a/app/src/main/java/com/ivanna/omega/ui/IvannaControlPanel.kt b/app/src/main/java/com/ivanna/omega/ui/IvannaControlPanel.kt
index e54ee13..979332a 100644
--- a/app/src/main/java/com/ivanna/omega/ui/IvannaControlPanel.kt
+++ b/app/src/main/java/com/ivanna/omega/ui/IvannaControlPanel.kt
@@ -63,6 +63,11 @@ fun IvannaControlPanel(
     initialNhoHarmonic: Float = 0.0f,
     initialSpatialAngle: Float = 0.5f,
     initialSpatialWidth: Float = 0.5f,
+    initialHrtfWet: Float = 0f,
+    initialReflectionGain0: Float = 0f,
+    initialReflectionGain1: Float = 0f,
+    initialReflectionGain2: Float = 0f,
+    initialReflectionGain3: Float = 0f,
     initialEvoEnabled: Boolean = true,
     initialNpeBypass: Boolean = false,
     initialNpeHarmonic: Float = 0.2f,
@@ -88,6 +93,8 @@ fun IvannaControlPanel(
     onNhoHarmonicChange: (Float) -> Unit = {},
     onSpatialAngleChange: (Float) -> Unit = {},
     onSpatialWidthChange: (Float) -> Unit = {},
+    onHrtfWetChange: (Float) -> Unit = {},
+    onReflectionGainChange: (Int, Float) -> Unit = { _, _ -> },
     onEvoEnabledChange: (Boolean) -> Unit = {},
     onNpeBypassChange: (Boolean) -> Unit = {},
     onNpeHarmonicChange: (Float) -> Unit = {},
@@ -131,6 +138,11 @@ fun IvannaControlPanel(
     var nhoHarmonic by remember { mutableFloatStateOf(initialNhoHarmonic) }
     var spatialAngle by remember { mutableFloatStateOf(initialSpatialAngle) }
     var spatialWidth by remember { mutableFloatStateOf(initialSpatialWidth) }
+    var hrtfWet by remember { mutableFloatStateOf(initialHrtfWet) }
+    var reflGain0 by remember { mutableFloatStateOf(initialReflectionGain0) }
+    var reflGain1 by remember { mutableFloatStateOf(initialReflectionGain1) }
+    var reflGain2 by remember { mutableFloatStateOf(initialReflectionGain2) }
+    var reflGain3 by remember { mutableFloatStateOf(initialReflectionGain3) }
     var evoEnabled by remember { mutableStateOf(initialEvoEnabled) }
     var evoFitness by remember { mutableFloatStateOf(0f) }
     var evoGeneration by remember { mutableIntStateOf(0) }
@@ -394,6 +406,32 @@ fun IvannaControlPanel(
             AuroraSlider("ANCHO ESPACIAL", spatialWidth, 0f..1.5f) {
                 spatialWidth = it; onSpatialWidthChange(it)
             }
+            // FIX (PUNTO 4): nativeSetSpatialWet y nativeSetReflectionGain
+            // existían en IvannaNativeLib pero sin sliders en la UI.
+            //
+            // AVISO: nativeSetSpatialWet también lo pisa
+            // PiLstmBridge.setCochlearEnabled() como interruptor binario
+            // forzado (toggle "Cochlear" en la card NPE → 0f/1f). Es
+            // comportamiento preexistente, no introducido acá: si tocás
+            // ese toggle después de mover este slider, el valor manual se
+            // pierde. Ambos escriben al mismo parámetro nativo porque así
+            // ya estaba diseñado — no lo cambié para no alterar el
+            // comportamiento del toggle existente.
+            AuroraSlider("HRTF WET", hrtfWet, 0f..1f) {
+                hrtfWet = it; onHrtfWetChange(it)
+            }
+            AuroraSlider("REFLEXIÓN TEMPRANA 1", reflGain0, 0f..1f) {
+                reflGain0 = it; onReflectionGainChange(0, it)
+            }
+            AuroraSlider("REFLEXIÓN TEMPRANA 2", reflGain1, 0f..1f) {
+                reflGain1 = it; onReflectionGainChange(1, it)
+            }
+            AuroraSlider("REFLEXIÓN TEMPRANA 3", reflGain2, 0f..1f) {
+                reflGain2 = it; onReflectionGainChange(2, it)
+            }
+            AuroraSlider("REFLEXIÓN TEMPRANA 4", reflGain3, 0f..1f) {
+                reflGain3 = it; onReflectionGainChange(3, it)
+            }
         }
 
         GlassCard(
