From af7c7957186fa1274299429e5c87fbf71cb1c8f6 Mon Sep 17 00:00:00 2001
From: "Gore TNS (audit session)" <gore-tns@ivanna-omega.local>
Date: Wed, 22 Jul 2026 22:33:41 +0000
Subject: [PATCH 3/5] chore(build): quitar dependencia runtime-livedata sin uso
 tras eliminar AdaptiveEngineScreen.kt
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

VERIFICADO: cero llamadas a observeAsState() en todo el repo tras el
commit anterior (que elimino ui/AdaptiveEngineScreen.kt, el unico
consumidor de esa API). runtime-livedata quedaba sin ningun uso real.

Se actualizan tambien los comentarios de las lineas vecinas, que
mencionaban por nombre archivos (VoiceProtectionManager.kt,
AdaptiveEngineScreen.kt) que ya no existen — para que no desinformen a
la proxima persona/sesion que lea build.gradle.kts.

lifecycle-livedata-ktx SI se conserva: verificado que AudioStateManager.kt
(vivo, en produccion) sigue usando LiveData/MutableLiveData directamente.
---
 app/build.gradle.kts | 13 ++++---------
 1 file changed, 4 insertions(+), 9 deletions(-)

diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index ac71079..7d28bd1 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -92,16 +92,11 @@ dependencies {
     implementation("androidx.compose.material3:material3:1.2.0")
     implementation("androidx.compose.ui:ui-tooling-preview:1.6.0")
     implementation("androidx.lifecycle:lifecycle-runtime-ktx:2.7.0")
-    // FIX (bb4fa6b): AudioStateManager.kt y VoiceProtectionManager.kt usan
-    // androidx.lifecycle.LiveData/MutableLiveData. lifecycle-runtime-ktx NO
-    // trae esas clases (son un artefacto distinto) — faltaba, el build de
-    // esos dos archivos truena con "unresolved reference: LiveData".
+    // FIX (bb4fa6b): AudioStateManager.kt usa androidx.lifecycle.LiveData/
+    // MutableLiveData. lifecycle-runtime-ktx NO trae esas clases (son un
+    // artefacto distinto) — faltaba, el build de ese archivo truena con
+    // "unresolved reference: LiveData".
     implementation("androidx.lifecycle:lifecycle-livedata-ktx:2.7.0")
-    // FIX: AdaptiveEngineScreen.kt usa LiveData.observeAsState() en Compose
-    // -- eso vive en un artefacto aparte (runtime-livedata), no en
-    // compose.runtime ni en lifecycle-livedata-ktx. Mismo tipo de bug que
-    // los anteriores (dependencia usada pero nunca declarada).
-    implementation("androidx.compose.runtime:runtime-livedata:1.6.0")
     implementation("androidx.activity:activity-compose:1.8.2")
     implementation("androidx.navigation:navigation-compose:2.7.7")
     implementation("androidx.lifecycle:lifecycle-viewmodel-compose:2.7.0")
-- 
