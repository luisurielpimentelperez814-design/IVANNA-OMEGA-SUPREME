From ebd630eb37e3c17dc908a475f2105f69c0855e31 Mon Sep 17 00:00:00 2001
From: IVANNA CI Fix <ivanna-ci@goreTNS.dev>
Date: Sat, 25 Jul 2026 07:12:49 +0000
Subject: [PATCH] fix(MainActivity): resolver Type mismatch ParameterStore core
 vs audio
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ERROR: MainActivity.kt:92:44
  inferred type is com.ivanna.omega.core.ParameterStore
  but com.ivanna.omega.audio.ParameterStore was expected

CAUSA RAÍZ: VoiceProtectionManager (audio) declara su constructor con
  audio.ParameterStore (necesita loadParameters() -> AudioState).
  La ruta 'adaptive' en el NavHost estaba usando core.ParameterStore
  (sin qualificacion completa, import incorrecto).

FIX: Agregar composable('adaptive') con nombres completamente cualificados:
  - com.ivanna.omega.audio.ParameterStore   <-- CORRECTO
  - com.ivanna.omega.audio.VoiceProtectionManager
  - com.ivanna.omega.ui.AdaptiveEngineScreen (internal, mismo modulo)

Reglas respetadas:
  - Sin clases nuevas
  - Sin mover paquetes
  - Sin cambiar arquitectura
  - DSPState intacto
  - pushToNative() intacto
---
 .../main/java/com/ivanna/omega/MainActivity.kt | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/ivanna/omega/MainActivity.kt b/app/src/main/java/com/ivanna/omega/MainActivity.kt
index 0e934ae..288a13d 100644
--- a/app/src/main/java/com/ivanna/omega/MainActivity.kt
+++ b/app/src/main/java/com/ivanna/omega/MainActivity.kt
@@ -70,11 +70,27 @@ fun OmegaApp() {
     val nav = rememberNavController()
     val dsp = remember { mutableStateOf(DSPState()) }
     MaterialTheme(colorScheme = darkColorScheme(background = Carbon, surface = Surface1)) {
-        // ← PUNTO 1: Agregar ruta "adaptive" al NavHost
         NavHost(nav, startDestination = "splash") {
             composable("splash") { SplashScreen { nav.navigate("intro") } }
             composable("intro") { IntroScreen { nav.navigate("dashboard") } }
             composable("dashboard") { DashboardScreen(dsp, nav) }
+            // Ruta Adaptive Engine — usa audio.ParameterStore (NO core.ParameterStore)
+            // FIX: MainActivity.kt:92:44 Type mismatch resuelto usando nombres completos
+            composable("adaptive") {
+                val ctx = LocalContext.current
+                val voiceManager = remember(ctx) {
+                    com.ivanna.omega.audio.VoiceProtectionManager(
+                        com.ivanna.omega.audio.ParameterStore(ctx)
+                    )
+                }
+                com.ivanna.omega.ui.AdaptiveEngineScreen(
+                    voiceProtectionManager = voiceManager,
+                    modifier = Modifier
+                        .fillMaxSize()
+                        .background(Carbon)
+                        .windowInsetsPadding(WindowInsets.systemBars)
+                )
+            }
         }
     }
 }
