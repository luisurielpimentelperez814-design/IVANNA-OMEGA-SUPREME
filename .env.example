# ==============================================================================
# IVANNA OMEGA SUPREME — Control Dashboard web
# Variables de entorno reales consumidas por server.ts y vite.config.ts.
# Copia este archivo a .env y rellena los valores.
# ==============================================================================

# GEMINI_API_KEY: clave de la API de Gemini (Google AI Studio).
# Requerida SOLO para el proxy de chat (/api/chat). Si no se define, el
# dashboard arranca igual y el chat responde 503 con mensaje explícito.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: puerto del servidor Express (default 3000).
# PORT=3000

# NODE_ENV: "production" sirve el build estático de dist/; cualquier otro
# valor arranca el middleware de Vite en modo desarrollo con HMR.
# NODE_ENV=production

# DISABLE_HMR: "true" desactiva el Hot Module Replacement de Vite en
# desarrollo (útil en entornos con agentes editando archivos).
# DISABLE_HMR=true
