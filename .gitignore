# ============================================================================
# IVANNA OMEGA SUPREME - .gitignore
# ============================================================================

.gradle/
build/
# Directorios de build locales de verificación host (no se commitean).
build-hyper/
build-sensor/
build-tests/
.idea/
.vscode/
*.iml
*.log
*.apk
*.aab
*.aar
*.class
*.dex
*.jar
*.so
*.sofa
# Los SOFA de assets/ y del modulo SON parte del producto (puerta 0.6 check_datasets_deploy.py): sin esta
# excepcion `git add -A` los omitia en silencio y 23 HpIR de ari/ nunca llegaron al repo ni al zip.
!app/src/main/assets/ivanna_omega/sofa/**/*.sofa
!magisk_module/system/etc/ivanna_omega/sofa/**/*.sofa
*.tmp
*.temp
*.swp
*.swo
*.DS_Store
local.properties
*.keystore
*.jks
google-services.json
.DS_Store
Thumbs.db
coverage/
node_modules/
dist/
bun.lock
.cxx/
app/release/

__pycache__/

.kotlin/
dist-fotoholo/

# Generated by the web build/staging step in CI.
app/src/main/assets/fotoholo-web/

# Seguridad anti-piratería (v2.5.369): pin de certificado generado en build-time.
# No se commitea (es secreto de build; el header se regenera en cada build).
app/src/main/cpp/security/ivanna_build_pins.h

# Seguridad anti-piratería fase 2: asset con los hashes de las .so, generado
# en build-time por generateSoHashes. No se commitea (se regenera en cada
# build; el hash cambia con cada compilación de la .so).
app/src/main/assets/ivanna_so_hashes.txt
