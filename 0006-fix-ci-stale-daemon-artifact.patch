+          test -f magisk_module/sepolicy.rule || { echo "ERROR: falta sepolicy.rule"; exit 1; }
+          if grep -vE '^[[:space:]]*(#|$)' magisk_module/sepolicy.rule | grep -qE '[:;]'; then
+            echo "ERROR: sepolicy.rule usa sintaxis .te (: o ;) — magiskpolicy la rechaza"
+            grep -nE '[:;]' magisk_module/sepolicy.rule
+            exit 1
           fi
+
           cd magisk_module
