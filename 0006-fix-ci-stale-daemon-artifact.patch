+          test -f ivanna_daemon || { echo "ERROR: ivanna_daemon no compilado — no se empaqueta un binario viejo"; exit 1; }
+          mkdir -p magisk_module/system/bin
+          rm -f magisk_module/system/bin/ivanna_daemon
+          cp ivanna_daemon magisk_module/system/bin/ivanna_daemon
+          chmod 755 magisk_module/system/bin/ivanna_daemon
+
+          # Sello de build verificable en el dispositivo:
