# IVANNA OMEGA SUPREME — ASRC v6 write-stage / FUSIÓN MAGISTRAL (Moto G85 5G)
# ¡ACTIVO POR DEFECTO desde v2.5.401! El músculo (ASRC v6) se ancla
# AUTOMÁTICAMENTE al HAL en cada arranque. customize.sh copia este archivo
# a overlay.d/ y crea el marcador .preload_optin en cada instalación, así
# que post-fs-data.sh no lo retira. La .so v6 es fail-closed y el cerebro
# (daemon v2) la controla por el estado de fusión: sin cerebro vivo o ratio
# viejo, el músculo pasa el audio sin tocarlo. El kill switch pal_asrc.off
# NO protege el caso del constructor (solo actúa DESPUÉS de cargar la .so);
# el rollback es borrar overlay.d/ivanna_audio.rc y .preload_optin y
# reiniciar, o el safe-mode de post-fs-data.sh tras 3 arranques fallidos.
# Adaptación del overlay.d/ivanna_audio.rc del módulo ivanna_audio_probe
# (~/workspace/preload-evidence/20261107/overlay.d_ivanna_audio.rc, 510 B):
# stanza COMPLETA del servicio vendor.audio-hal replicada del fabricante
# (incl. class/user/group/capabilities/ioprio/writepid/onrestart) + override
# + setenv con la librería v6. Único cambio respecto al original: la ruta
# de la librería. Magisk overlay.d imports this after init.rc.
service vendor.audio-hal /vendor/bin/hw/android.hardware.audio.service_64
    override
    setenv LD_PRELOAD /vendor/lib64/libivanna_asrc_write_stage.so
    class hal
    user audioserver
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin oem_2901 wakelock
    capabilities BLOCK_SUSPEND SYS_NICE
    ioprio rt 4
    writepid /dev/cpuset/foreground/tasks /dev/stune/foreground/tasks
    onrestart restart audioserver
