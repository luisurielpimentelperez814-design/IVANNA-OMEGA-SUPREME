  "private": true,
  "version": "2.3.6",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/server.cjs",
