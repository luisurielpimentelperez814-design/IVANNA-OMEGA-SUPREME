+int dsp_hrtf_init(void* h, uint32_t sr_in, uint32_t sr_out,
+                  uint32_t taps, uint32_t block) noexcept {
+    if (!has_hrtf()) return -1;
+    return g_vt.hrtf_init(h, sr_in, sr_out, taps, block);
+}
+int dsp_hrtf_convolve(void* h,
+                      const float* in_l, uint32_t in_l_n,
+                      const float* in_r, uint32_t in_r_n,
+                      float* out_l, uint32_t out_l_n,
+                      float* out_r, uint32_t out_r_n,
+                      float az, float el, uint32_t frames) noexcept {
+    if (!has_hrtf() || !h) return -1;
+    return g_vt.hrtf_convolve(h,
+                              in_l, (int)in_l_n, in_r, (int)in_r_n,
+                              out_l, (int)out_l_n, out_r, (int)out_r_n,
+                              az, el, frames);
+}
+int dsp_fir_init(void* h, uint32_t up, uint32_t taps) noexcept {
+    if (!has_fir()) return -1;
+    return g_vt.fir_init(h, up, taps);
+}
+int dsp_fir_upsample(void* h,
+                     const float* in, uint32_t in_n,
+                     float* out, uint32_t out_n,
+                     uint32_t frames) noexcept {
+    if (!has_fir() || !h) return -1;
+    return g_vt.fir_upsample(h, in, (int)in_n, out, (int)out_n, frames);
+}
+
+// ── DMA-BUF (rpcmem) — cae a posix_memalign si el transporte no lo expone ────
+void* dma_alloc(size_t bytes) noexcept {
+    if (bytes == 0) return nullptr;
+    if (g_dsp_available.load(std::memory_order_acquire) && g_tv.rpcmem_alloc) {
+        return g_tv.rpcmem_alloc(RPCMEM_HEAP_ID_SYSTEM, RPCMEM_DEFAULT_FLAGS, (int)bytes);
+    }
+    void* p = nullptr;
+    if (posix_memalign(&p, 64, bytes) != 0) return nullptr;
+    return p;
+}
+void dma_free(void* p) noexcept {
+    if (!p) return;
+    if (g_tv.rpcmem_free) { g_tv.rpcmem_free(p); return; }
+    free(p);
+}
+
 }}} // namespace ivanna::hexagon::rt
