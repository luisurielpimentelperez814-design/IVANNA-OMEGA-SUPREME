+// Delega al loader unificado. Resuelve símbolos DIRECTAMENTE del stub qaic
+// (`libivanna_dsp_stub.so`) — no del transporte FastRPC.
+static ResolvedSymbols g_syms{};
+static std::once_flag  g_once;
+
+static void do_resolve() {
+    if (!ivanna::hexagon::ensure_available()) return;
+    // El stub ya está dlopen'd por `ivanna::hexagon::rt`. Reabrirlo con
+    // RTLD_NOLOAD sólo devuelve el handle existente sin incrementar refcount.
+    void* sh = dlopen("libivanna_dsp_stub.so", RTLD_NOW | RTLD_NOLOAD);
+    if (!sh) return;
+    g_syms.dsp_open          = dlsym(sh, "ivanna_dsp_open");
+    g_syms.dsp_close         = dlsym(sh, "ivanna_dsp_close");
+    g_syms.dsp_hrtf_init     = dlsym(sh, "ivanna_dsp_hrtf_init");
+    g_syms.dsp_hrtf_convolve = dlsym(sh, "ivanna_dsp_hrtf_convolve");
+    g_syms.dsp_fir_init      = dlsym(sh, "ivanna_dsp_fir_init");
+    g_syms.dsp_fir_upsample  = dlsym(sh, "ivanna_dsp_fir_upsample");
+    dlclose(sh); // sólo decrementa el refcount añadido por NOLOAD
+    if (g_syms.dsp_open && g_syms.dsp_close) {
+        g_syms.lib_name = ivanna::hexagon::active_library();
+        g_syms.loaded   = true;
+    }
+}
 
 const ResolvedSymbols& resolved_symbols() noexcept {
     std::call_once(g_once, do_resolve);
     return g_syms;
 }
 
 bool is_loaded() noexcept { return resolved_symbols().loaded; }
 
 }}} // namespace ivanna::dsp::phaseh
