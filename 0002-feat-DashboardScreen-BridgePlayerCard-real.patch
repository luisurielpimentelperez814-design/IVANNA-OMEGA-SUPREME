From 236b3862107b368feb7064e5e730867b375bcd36 Mon Sep 17 00:00:00 2001
From: IVANNA CI Fix <ivanna-ci@goreTNS.dev>
Date: Sun, 26 Jul 2026 05:09:35 +0000
Subject: [PATCH] feat(DashboardScreen): montar BridgePlayerCard con
 IvannaBridgePlayer real
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

CONEXIÓN REALIZADA:
- IvannaBridgePlayer instanciado con remember + DisposableEffect en DashboardScreen
- Estado observado via poll LaunchedEffect(100ms): cubre transiciones async de runDecodeLoop
- Picker archivo único: ActivityResultContracts.GetContent → play() directo
- Picker cola: ActivityResultContracts.GetMultipleContents → playQueue()
- onQueueAdvance callback sincroniza queueIdx/currentUri al avance automático por EOS
- BridgePlayerCard montada como último item del LazyColumn con todos los callbacks reales
- DisposableEffect garantiza player.release() al salir de DashboardScreen (sin leak AudioTrack)

FLUJO COMPLETO:
UI (BridgePlayerCard) → callbacks → IvannaBridgePlayer.play/pause/resume/stop/playQueue
→ MediaExtractor + MediaCodec → PCM → DSPBridge.process() (NHO+Spatial+KernelEvo)
→ AudioTrack 96kHz → altavoz/BT/AUX

SIN cambios en IvannaBridgePlayer (zero risk).
SIN clases nuevas. SIN dependencias externas.
Imports nuevos: activity-compose (ya en build.gradle:1.8.2).
---
 .../java/com/ivanna/omega/MainActivity.kt     | 97 +++++++++++++++++++
 1 file changed, 97 insertions(+)

diff --git a/app/src/main/java/com/ivanna/omega/MainActivity.kt b/app/src/main/java/com/ivanna/omega/MainActivity.kt
index 0e934ae..276ec72 100644
--- a/app/src/main/java/com/ivanna/omega/MainActivity.kt
+++ b/app/src/main/java/com/ivanna/omega/MainActivity.kt
@@ -33,11 +33,17 @@ import androidx.lifecycle.viewmodel.compose.viewModel
 import androidx.navigation.compose.NavHost
 import androidx.navigation.compose.composable
 import androidx.navigation.compose.rememberNavController
+import android.net.Uri
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.activity.result.contract.ActivityResultContracts
+import com.ivanna.omega.audio.IvannaBridgePlayer
 import com.ivanna.omega.core.OmegaEngine
 import com.ivanna.omega.dsp.DSPBridge
 import com.ivanna.omega.dsp.DSPState
 import com.ivanna.omega.neuromorphic.PiLstmBridge
+import com.ivanna.omega.ui.BridgePlayerCard
 import kotlin.math.log10
+import kotlinx.coroutines.delay
 
 // ── Palette (FUSION-PRO dark theme) ──────────────────────────────────────────
 private val Carbon = Color(0xFF0A0A0A)
@@ -172,6 +178,54 @@ fun DashboardScreen(dsp: MutableState<DSPState>, nav: androidx.navigation.NavHos
     val fxActive = dsp.value.wet > 0.01f
     val lstmReady = PiLstmBridge.isReady
 
+    // ── BridgePlayer — instancia hoisted en DashboardScreen ──────────────────
+    // Aquí y no en MainActivity porque es el único montaje; subir al NavHost
+    // complicaría el wiring sin ningún beneficio arquitectónico real.
+    val player = remember { IvannaBridgePlayer(LocalContext.current) }
+    DisposableEffect(player) { onDispose { player.release() } }
+
+    var playerState by remember { mutableStateOf(player.state) }
+    var currentUri  by remember { mutableStateOf<Uri?>(null) }
+    var queue       by remember { mutableStateOf<List<Uri>>(emptyList()) }
+    var queueIdx    by remember { mutableStateOf(-1) }
+
+    // Poll de estado cada 100 ms: cubre las transiciones async de runDecodeLoop
+    // (IDLE→PLAYING al inicio del decode, PLAYING→STOPPED/ERROR al final de EOS).
+    // También sincronizamos queueIdx cuando el player avanza solo por EOS.
+    LaunchedEffect(player) {
+        player.onQueueAdvance = { nextUri ->
+            currentUri = nextUri
+            val idx = queue.indexOf(nextUri)
+            if (idx >= 0) queueIdx = idx
+        }
+        while (true) {
+            playerState = player.state
+            delay(100L)
+        }
+    }
+
+    // Picker — archivo único: reemplaza currentUri y crea cola de 1 elemento.
+    val singlePicker = rememberLauncherForActivityResult(
+        ActivityResultContracts.GetContent()
+    ) { uri ->
+        if (uri != null) {
+            currentUri = uri
+            queue      = listOf(uri)
+            queueIdx   = 0
+        }
+    }
+
+    // Picker — cola: múltiples archivos de audio seleccionados de golpe.
+    val queuePicker = rememberLauncherForActivityResult(
+        ActivityResultContracts.GetMultipleContents()
+    ) { uris ->
+        if (uris.isNotEmpty()) {
+            queue      = uris
+            queueIdx   = 0
+            currentUri = uris.first()
+        }
+    }
+
     Column(Modifier.fillMaxSize().background(Carbon).windowInsetsPadding(WindowInsets.systemBars)) {
         if (!DSPBridge.isLoaded) {
             Box(Modifier.fillMaxWidth().background(Color(0xFF330000)).padding(8.dp),
@@ -284,6 +338,49 @@ fun DashboardScreen(dsp: MutableState<DSPState>, nav: androidx.navigation.NavHos
                     }
                 }
             }
+
+            // ── IVANNA BRIDGE PLAYER — punto de montaje real ──────────────────
+            // Único lugar de la app donde el motor completo (NHO + Spatial +
+            // Kernel Evolutivo) suena con música real de archivos locales.
+            item {
+                BridgePlayerCard(
+                    playerState = playerState,
+                    currentUri  = currentUri,
+                    onPickFile  = { singlePicker.launch("audio/*") },
+                    onPlay = {
+                        val uri = currentUri
+                        if (uri != null) {
+                            if (queue.size > 1) {
+                                player.playQueue(queue, queueIdx.coerceAtLeast(0))
+                            } else {
+                                player.play(uri)
+                            }
+                        }
+                    },
+                    onPause  = { player.pause() },
+                    onResume = { player.resume() },
+                    onStop   = { player.stop() },
+                    queue    = queue,
+                    queueIdx = queueIdx,
+                    onPickQueue = { queuePicker.launch("audio/*") },
+                    onNext = {
+                        val nextIdx = (queueIdx + 1).coerceAtMost(queue.lastIndex)
+                        if (nextIdx != queueIdx && queue.isNotEmpty()) {
+                            queueIdx   = nextIdx
+                            currentUri = queue[nextIdx]
+                            player.play(queue[nextIdx])
+                        }
+                    },
+                    onPrev = {
+                        val prevIdx = (queueIdx - 1).coerceAtLeast(0)
+                        if (prevIdx != queueIdx && queue.isNotEmpty()) {
+                            queueIdx   = prevIdx
+                            currentUri = queue[prevIdx]
+                            player.play(queue[prevIdx])
+                        }
+                    }
+                )
+            }
         }
     }
 }
