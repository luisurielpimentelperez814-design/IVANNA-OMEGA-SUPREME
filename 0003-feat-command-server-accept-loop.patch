+// FIX (fusion OmegaDaemonV8 -> CommandServer): antes CommandServer solo
+// bind()+listen()aba @omega_command_socket y nunca llamaba accept() -- el
+// log decia "CONTROL socket ready" pero cualquier cliente que conectara se
+// quedaba colgado en el backlog para siempre. El dispatcher JSON completo
+// (SET_EQ_BANDS, SET_INTENSITY, SET_ROUTE_PROFILE, etc.) vivia aislado en
+// OmegaDaemonV8.cpp, un binario huerfano que ademas bindeaba el MISMO
+// nombre de socket que ya usa ivanna_daemon.cpp para el handshake
+// SCM_RIGHTS (@omega_daemon_socket) -- riesgo de colision si alguien lo
+// hubiera vuelto a enlazar.
+//
+// Aqui se fusionan ambos: el socket correcto (@omega_command_socket, sin
+// colision) recibe un accept-loop real en un hilo dedicado, y cada comando
+// se aplica directo sobre el OmegaSharedState que vive en omega_shm (el
+// mismo struct que Ruta A ya lee/escribe via JNI) -- una sola fuente de
+// verdad, sin un tercer struct paralelo.
 class CommandServer {
 public:
-    bool start(const std::string& socketName);
+    bool start(const std::string& socketName, OmegaSharedState* sharedState);
     void stop();
 
 private:
+    static void* acceptLoopThunk(void* self);
+    void acceptLoop();
+    void handleClient(int clientFd);
+
     int serverFd = -1;
+    OmegaSharedState* state = nullptr;
+    pthread_t acceptThread{};
+    std::atomic<bool> running{false};
 };
