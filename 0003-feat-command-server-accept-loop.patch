-void CommandServer::stop()
-{
-    if(serverFd >= 0)
-    {
+void CommandServer::stop() {
+    running.store(false, std::memory_order_release);
+    if (serverFd >= 0) {
+        // shutdown() desbloquea el accept() bloqueado en el hilo del loop
+        shutdown(serverFd, SHUT_RDWR);
         close(serverFd);
         serverFd = -1;
     }
+    if (acceptThread) {
+        pthread_join(acceptThread, nullptr);
+        acceptThread = 0;
+    }
+}
+
+void* CommandServer::acceptLoopThunk(void* self) {
+    static_cast<CommandServer*>(self)->acceptLoop();
+    return nullptr;
+}
+
+void CommandServer::acceptLoop() {
+    while (running.load(std::memory_order_acquire)) {
+        int clientFd = accept(serverFd, nullptr, nullptr);
+        if (clientFd < 0) {
+            // serverFd cerrado por stop() -> accept() retorna error, salimos limpio
+            if (!running.load(std::memory_order_acquire)) break;
+            continue;
+        }
+        // Un comando por conexion, igual que el protocolo original de
+        // OmegaDaemonV8 (el cliente conecta, manda un JSON, lee la
+        // respuesta, cierra). Atendido en el mismo hilo del accept-loop:
+        // el volumen de comandos de control es bajo (UI/telemetria, no
+        // audio en tiempo real), no justifica un hilo por conexion.
+        handleClient(clientFd);
+    }
+}
+
+void CommandServer::handleClient(int clientFd) {
+    char recvBuf[4096];
+    char sendBuf[1024];
+
+    ssize_t n = recv(clientFd, recvBuf, sizeof(recvBuf) - 1, 0);
+    if (n <= 0) {
+        close(clientFd);
+        return;
+    }
+    recvBuf[n] = '\0';
+
+    int replyLen = 0;
+
+    if (!state) {
+        replyLen = snprintf(sendBuf, sizeof(sendBuf),
+            "{\"ok\":false,\"error\":\"shared state not ready\"}");
+    } else {
+        const char* action = jsonGetAction(recvBuf);
+
+        if (strcmp(action, "SET_EQ_BANDS") == 0) {
+            float gains[OmegaSharedState::OMEGA_EQ_BANDS] = {0};
+            bool ok = jsonGetArrayFloats(recvBuf, "gains", gains, OmegaSharedState::OMEGA_EQ_BANDS);
+            if (ok) {
+                for (int i = 0; i < OmegaSharedState::OMEGA_EQ_BANDS; i++)
+                    state->eq_gains[i].store(clampf(gains[i], -15.f, 15.f), std::memory_order_relaxed);
+            }
+            state->eq_listen_phon.store(jsonGetFloat(recvBuf, "listenPhon", state->eq_listen_phon.load()), std::memory_order_relaxed);
+            state->eq_ref_phon.store(jsonGetFloat(recvBuf, "refPhon", state->eq_ref_phon.load()), std::memory_order_relaxed);
+            state->eq_calibrated.store(ok, std::memory_order_relaxed);
+            replyLen = snprintf(sendBuf, sizeof(sendBuf),
+                "{\"ok\":true,\"action\":\"SET_EQ_BANDS\",\"calibrated\":%s}", ok ? "true" : "false");
+
+        } else if (strcmp(action, "SET_INTENSITY") == 0) {
+            float v = clampf(jsonGetFloat(recvBuf, "intensity", state->intensity.load()), 0.f, 1.f);
+            state->intensity.store(v, std::memory_order_relaxed);
+            replyLen = snprintf(sendBuf, sizeof(sendBuf), "{\"ok\":true,\"intensity\":%.3f}", v);
+
+        } else if (strcmp(action, "SET_ADAPTIVE_STATE") == 0) {
+            // targetGain se mapea a ai_runtime_gain_mul (unico multiplicador
+            // de ganancia adaptativa que ya existe en el struct canonico).
+            state->ai_runtime_gain_mul.store(jsonGetFloat(recvBuf, "targetGain", state->ai_runtime_gain_mul.load()), std::memory_order_relaxed);
+            state->ai_runtime_comp_amount.store(jsonGetFloat(recvBuf, "compAmount", state->ai_runtime_comp_amount.load()), std::memory_order_relaxed);
+            state->ai_runtime_exciter_red.store(jsonGetFloat(recvBuf, "excRed", state->ai_runtime_exciter_red.load()), std::memory_order_relaxed);
+            replyLen = snprintf(sendBuf, sizeof(sendBuf), "{\"ok\":true,\"action\":\"SET_ADAPTIVE_STATE\"}");
+
+        } else if (strcmp(action, "SET_PERCEPTUAL_STATE") == 0) {
+            // compressor/exciterReduction/spatialWidth mapean a los mismos
+            // campos runtime que SET_ADAPTIVE_STATE -- son el mismo control,
+            // dos nombres historicos distintos. highCutHz/loudnessTargetLuFS/
+            // harmonicGain/antiDolbyIntensity NO tienen campo equivalente
+            // todavia en OmegaSharedState: se ignoran (no se inventan campos
+            // nuevos en este parche) y se reportan como unmapped en la reply.
+            state->ai_runtime_comp_amount.store(jsonGetFloat(recvBuf, "compressor", state->ai_runtime_comp_amount.load()), std::memory_order_relaxed);
+            state->ai_runtime_exciter_red.store(jsonGetFloat(recvBuf, "exciterReduction", state->ai_runtime_exciter_red.load()), std::memory_order_relaxed);
+            state->ai_runtime_spatial_width.store(jsonGetFloat(recvBuf, "spatialWidth", state->ai_runtime_spatial_width.load()), std::memory_order_relaxed);
+            replyLen = snprintf(sendBuf, sizeof(sendBuf),
+                "{\"ok\":true,\"action\":\"SET_PERCEPTUAL_STATE\","
+                "\"unmapped\":[\"highCutHz\",\"loudnessTargetLuFS\",\"harmonicGain\",\"antiDolbyIntensity\"]}");
+
+        } else if (strcmp(action, "SET_PF_PARAMS") == 0) {
+            float p[13];
+            if (jsonGetArrayFloats(recvBuf, "params", p, 13)) {
+                state->pf_drive.store(p[0], std::memory_order_relaxed);
+                state->pf_wet.store(p[1], std::memory_order_relaxed);
+                state->pf_mix.store(p[2], std::memory_order_relaxed);
+                state->pf_alpha.store(p[3], std::memory_order_relaxed);
+                state->pf_beta.store(p[4], std::memory_order_relaxed);
+                state->pf_gamma.store(p[5], std::memory_order_relaxed);
+                state->pf_freq.store(p[6], std::memory_order_relaxed);
+                state->pf_resonance.store(p[7], std::memory_order_relaxed);
+                state->pf_low.store(p[8], std::memory_order_relaxed);
+                state->pf_mid.store(p[9], std::memory_order_relaxed);
+                state->pf_high.store(p[10], std::memory_order_relaxed);
+                state->pf_presence.store(p[11], std::memory_order_relaxed);
+                state->pf_master.store(p[12], std::memory_order_relaxed);
+                // El hot-path recalcula coeficientes Biquad solo cuando esta
+                // version cambia (ver comentario original en omega_shared.h) --
+                // hay que bumpearla o el EQ nuevo nunca se aplica.
+                state->pf_param_version.fetch_add(1, std::memory_order_release);
+            }
+            replyLen = snprintf(sendBuf, sizeof(sendBuf), "{\"ok\":true,\"action\":\"SET_PF_PARAMS\"}");
+
+        } else if (strcmp(action, "SET_YAMNET_SCORES") == 0) {
+            state->ai_voice_score.store(jsonGetFloat(recvBuf, "speech", state->ai_voice_score.load()), std::memory_order_relaxed);
+            state->ai_music_score.store(jsonGetFloat(recvBuf, "music", state->ai_music_score.load()), std::memory_order_relaxed);
+            state->ai_yamnet_class_id.store((int)jsonGetFloat(recvBuf, "classId", (float)state->ai_yamnet_class_id.load()), std::memory_order_relaxed);
+            state->ai_yamnet_confidence.store(jsonGetFloat(recvBuf, "confidence", state->ai_yamnet_confidence.load()), std::memory_order_relaxed);
+            replyLen = snprintf(sendBuf, sizeof(sendBuf), "{\"ok\":true,\"action\":\"SET_YAMNET_SCORES\"}");
+
+        } else if (strcmp(action, "SET_ROUTE_PROFILE") == 0) {
+            state->route_bass_boost_db.store(jsonGetFloat(recvBuf, "bassBoostDb", state->route_bass_boost_db.load()), std::memory_order_relaxed);
+            state->route_dialog_boost_db.store(jsonGetFloat(recvBuf, "dialogBoostDb", state->route_dialog_boost_db.load()), std::memory_order_relaxed);
+            state->route_widener_mult.store(jsonGetFloat(recvBuf, "widenerMult", state->route_widener_mult.load()), std::memory_order_relaxed);
+            replyLen = snprintf(sendBuf, sizeof(sendBuf), "{\"ok\":true,\"action\":\"SET_ROUTE_PROFILE\"}");
+
+        } else if (strcmp(action, "SET_SAF_STATE") == 0) {
+            // OmegaSharedState no tiene todavia campos SAF (deltaEnergy/
+            // metricNorm/memory/gain) -- honesto: se ACK-ea sin aplicar nada,
+            // en vez de fabricar campos nuevos sin saber donde los lee el
+            // resto del pipeline. Queda pendiente para el proximo parche.
+            replyLen = snprintf(sendBuf, sizeof(sendBuf),
+                "{\"ok\":true,\"action\":\"SET_SAF_STATE\",\"applied\":false,"
+                "\"reason\":\"SAF fields not yet in OmegaSharedState\"}");
+
+        } else if (strcmp(action, "PING") == 0) {
+            replyLen = snprintf(sendBuf, sizeof(sendBuf), "{\"ok\":true,\"pong\":true}");
+
+        } else if (strcmp(action, "GET_STATUS") == 0) {
+            replyLen = snprintf(sendBuf, sizeof(sendBuf),
+                "{\"ok\":true,\"intensity\":%.3f,\"eq_calibrated\":%s,"
+                "\"comp_amount\":%.3f,\"exciter_red\":%.3f,\"spatial_width\":%.3f,"
+                "\"gain_mul\":%.3f}",
+                state->intensity.load(),
+                state->eq_calibrated.load() ? "true" : "false",
+                state->ai_runtime_comp_amount.load(),
+                state->ai_runtime_exciter_red.load(),
+                state->ai_runtime_spatial_width.load(),
+                state->ai_runtime_gain_mul.load());
+
+        } else {
+            replyLen = snprintf(sendBuf, sizeof(sendBuf),
+                "{\"ok\":false,\"error\":\"unknown action\",\"received\":\"%s\"}", action);
+        }
+    }
+
+    if (replyLen > 0) send(clientFd, sendBuf, (size_t)replyLen, 0);
+    close(clientFd);
 }
