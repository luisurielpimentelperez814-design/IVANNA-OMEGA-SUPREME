+// Semantica preservada del stub original: si el daemon no esta corriendo
+// (Magisk module inactivo, o el proceso app arranca antes que el daemon),
+// devuelve nullptr y el caller ya maneja ese caso con
+// `if (!shared) continue;` -- el hilo puente duerme silenciosamente.
+// Reintenta la conexion con backoff en vez de en cada llamada (el loop
+// llama esto cada ~30ms; sin backoff, un daemon caido generaria un
+// connect() fallido 33 veces por segundo indefinidamente).
 
 #include <android/log.h>
 #include <atomic>
+#include <cerrno>
+#include <cstring>
+#include <ctime>
+
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <sys/mman.h>
+#include <unistd.h>
 
 #include "include/omega_shared.h"
 
 #define LOG_TAG "OmegaDaemonBridge"
 
+namespace {
+
+constexpr const char* kSocketName = "omega_daemon_socket"; // abstract, sin '@' aqui
+constexpr int64_t kRetryBackoffNs = 2LL * 1000 * 1000 * 1000; // 2s
+
+std::atomic<OmegaSharedState*> g_cached{nullptr};
+std::atomic<int64_t> g_nextRetryNs{0};
+
+int64_t nowNs() {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+// Conecta a ivanna_daemon, recibe el fd de omega_shm via SCM_RIGHTS y lo
+// mapea. Devuelve nullptr en cualquier fallo (daemon no corriendo, socket
+// no bindeado todavia, etc.) -- todos los fallos son silenciosos por
+// diseño (ver comentario de cabecera), solo se logea una vez por intento
+// fallido para no perder visibilidad total en logcat.
+OmegaSharedState* tryConnectAndMap() {
+    int sockFd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (sockFd < 0) return nullptr;
+
+    struct sockaddr_un addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    addr.sun_path[0] = '\0';
+    strncpy(addr.sun_path + 1, kSocketName, sizeof(addr.sun_path) - 2);
+    socklen_t addrLen = (socklen_t)(offsetof(struct sockaddr_un, sun_path) + 1 + strlen(kSocketName));
+
+    if (connect(sockFd, (struct sockaddr*)&addr, addrLen) < 0) {
+        close(sockFd);
+        return nullptr;
+    }
+
+    char data = 0;
+    struct iovec iov{&data, 1};
+    char control[CMSG_SPACE(sizeof(int))];
+    memset(control, 0, sizeof(control));
+
+    struct msghdr msg;
+    memset(&msg, 0, sizeof(msg));
+    msg.msg_iov = &iov;
+    msg.msg_iovlen = 1;
+    msg.msg_control = control;
+    msg.msg_controllen = sizeof(control);
+
+    ssize_t n = recvmsg(sockFd, &msg, 0);
+    if (n <= 0) {
+        close(sockFd);
+        return nullptr;
+    }
+
+    struct cmsghdr* cmsg = CMSG_FIRSTHDR(&msg);
+    if (!cmsg || cmsg->cmsg_type != SCM_RIGHTS) {
+        close(sockFd);
+        return nullptr;
+    }
+
+    int shmFd = -1;
+    memcpy(&shmFd, CMSG_DATA(cmsg), sizeof(int));
+    close(sockFd); // ya no se necesita el socket, el fd recibido es independiente
+
+    if (shmFd < 0) return nullptr;
+
+    // mmap DEBE cubrir exactamente sizeof(OmegaSharedState): el daemon
+    // ftruncate() el backing file a ese mismo tamaño (ver
+    // daemon/ivanna_daemon.cpp::setup_shared_memory). Si algun dia los
+    // tamaños divergen entre daemon y app (versiones de APK/daemon
+    // desalineadas), este mmap fallaria o mapearia menos de lo que el
+    // struct necesita -- por eso NO se hardcodea un tamaño aparte.
+    void* ptr = mmap(nullptr, sizeof(OmegaSharedState), PROT_READ | PROT_WRITE, MAP_SHARED, shmFd, 0);
+    close(shmFd); // mapping sobrevive al close del fd (semantica POSIX estandar)
+
+    if (ptr == MAP_FAILED) return nullptr;
+
+    // NO se hace placement-new aqui: el daemon ya construyo el
+    // OmegaSharedState en ese mismo backing file. Solo reinterpretamos el
+    // puntero -- construirlo de nuevo pisaria el estado real con basura
+    // por deben del constructor, dado que su llamada llega desde el otro
+    // proceso.
+    return reinterpret_cast<OmegaSharedState*>(ptr);
+}
